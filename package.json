{
  "name": "centrum",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:check": "node scripts/check-entry-bundle-size.mjs",
    "lint": "eslint .",
    "lint:ci": "eslint . --max-warnings=2000",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "validate:migrations": "node scripts/validate-migrations.mjs",
    "validate:production-migrations": "node scripts/check-production-migration-contract.mjs",
    "security:secrets": "node scripts/check-secrets.mjs",
    "security:rls": "node scripts/check-rls-boundaries.mjs",
    "security:diagnostics": "node scripts/check-readonly-diagnostics.mjs",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "lint:security": "eslint api src/contexts/useAuth.js src/services/alerting src/services/novaPoshtaService.js src/services/sentryLogger.js server",
    "db:types": "node scripts/db-types-sync.mjs",
    "typecheck": "tsc --noEmit",
    "ci": "npm run typecheck && npm run security:secrets && npm run security:rls && npm run security:diagnostics && npm run security:access-contract && npm run security:audit && npm run validate:migrations && npm run validate:production-migrations && node scripts/check-monthly-partitions.mjs && npm run lint:security && npm test && npm run build && npm run build:check",
    "smoke:production": "node --env-file=.env scripts/production-smoke.mjs",
    "smoke:public-release": "node scripts/smoke-public-release.mjs",
    "smoke:anon-storage": "node --env-file=.env scripts/smoke-anon-storage.mjs",
    "smoke:atomic-transition": "node --env-file=.env scripts/smoke-atomic-transition-readonly.mjs",
    "verify:deployment": "node scripts/verify-deployed-release.mjs",
    "backup:preflight": "node scripts/backup-restore-preflight.mjs",
    "backup:connectivity": "node --env-file=.env.restore.local scripts/check-production-db-connectivity.mjs",
    "backup:create": "node --env-file=.env.restore.local scripts/create-production-backup.mjs",
    "backup:configure": "node scripts/configure-backup-credentials.mjs",
    "backup:restore:local": "node scripts/restore-production-backup-local.mjs",
    "backup:verify:parity": "node --env-file=.env.restore.local scripts/verify-production-restore-parity.mjs",
    "audit:storage:production": "node --env-file=.env.restore.local scripts/audit-production-storage.mjs",
    "audit:chat-isolation:production": "node --env-file=.env.restore.local scripts/audit-production-chat-isolation.mjs",
    "audit:anon": "node --env-file=.env scripts/audit-anon-surface.mjs",
    "audit:access": "node scripts/audit-client-data-access.mjs",
    "audit:auth-bindings": "node --env-file=.env scripts/audit-auth-bindings.mjs",
    "security:access-contract": "node scripts/audit-client-data-access.mjs --check",
    "inspect": "node inspect_users.cjs",
    "load:test:staging": "node scripts/loadtest-readonly.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1132.0",
    "@sentry/react": "^10.74.0",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-virtual": "^3.14.12",
    "date-fns": "^4.4.0",
    "emoji-picker-react": "^4.20.7",
    "html5-qrcode": "^2.3.8",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^1.45.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "pg": "^8.23.0",
    "supabase": "2.117.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
