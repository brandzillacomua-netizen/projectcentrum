# ═══════════════════════════════════════════════════════════════════════════
# CENTRUM MES — Enterprise Environment Configuration Template
# Копіюйте цей файл у .env.local для локальної розробки
# ═══════════════════════════════════════════════════════════════════════════

# Публічна конфігурація браузерного Supabase-клієнта. Anon key не є
# серверним секретом, але всі права БД зобов'язані контролюватися JWT + RLS.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Моніторинг браузерних помилок (публічний DSN, без auth token).
VITE_SENTRY_DSN=

# Лише server-side середовище Vercel / Core Engine. Ніколи не додавати VITE_.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=SET_ONLY_IN_SERVER_SECRET_STORE
NOVA_POSHTA_API_KEY=SET_ONLY_IN_SERVER_SECRET_STORE
TELEGRAM_BOT_TOKEN=SET_ONLY_IN_SERVER_SECRET_STORE
TELEGRAM_CHAT_ID=SET_ONLY_IN_SERVER_SECRET_STORE
APP_ORIGIN=https://your-production-domain.example
