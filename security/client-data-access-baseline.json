{
  "version": 1,
  "description": "Reviewed client-side Supabase table operations. New tables or operations require an explicit security review.",
  "dynamicAccess": {
    "src/contexts/data/dataState.js": {
      "maxSites": 1,
      "operations": ["select"],
      "tables": ["inventory", "material_requests", "orders", "tasks", "work_cards"],
      "reason": "Reconnect catch-up uses a fixed table allowlist in dataRealtime.js."
    },
    "src/modules/Foreman2/features/admin-card-delete/useAdminCardDelete.js": {
      "maxSites": 1,
      "operations": ["delete"],
      "tables": ["material_requests", "scrap_classifications", "work_card_history"],
      "reason": "Administrative deletion iterates a fixed OPTIONAL_CARD_LINKED_TABLES allowlist."
    },
    "src/modules/VKYASettings.jsx": {
      "maxSites": 5,
      "operations": ["delete", "insert", "select", "update"],
      "tables": ["scrap_reasons", "vkya_restoration_stages"],
      "reason": "CatalogEditor receives one of two literal table props from the same component."
    }
  },
